# 凭据与本地环境 —— 绝对不要提交（仓库是公开的）
autodl.env
autodl2.env
autodl_new.env
instance.env
tunnel.conf
.qwenkey
*.key
*.pem
# 自检回路用的视觉 LLM 配置：含 API key，服务端自动生成，**绝不入库**
vision.env
# 自检回路的运行产物（每轮的图 + 判定 + 修订记录）
auto-runs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 运行产物 / 临时文件
_run.log
tunnel_run.log
*.log

# 实验产物（体积大：图片约 300 MB，仓库不收录；需要的话本地保留或另开 LFS）
test-data/
reports/
tmp_refs/
tmp_ab/
# CFG/负面提示词 A/B 实验的图表副本：脚本在 remote/scripts/，
# 这里的图只用于当次判图，没必要进仓库
exp/

# ── 例外：参考图+样式迁移实验里"是可读结论、不是图片"的那几个文件要进仓库 ──
# 出图（300 张，约 600 MiB）、画廊 HTML（引用了图）、zip/解包归档、对照表 PNG
# 仍然排除；只放逐图评分与其汇总，因为它们能脱离图片独立阅读与复核。
!exp/
exp/*
!exp/style-reference-migration-20260927/
exp/style-reference-migration-20260927/*
!exp/style-reference-migration-20260927/analysis/
exp/style-reference-migration-20260927/analysis/*
!exp/style-reference-migration-20260927/analysis/scores.csv
!exp/style-reference-migration-20260927/analysis/errors.csv
!exp/style-reference-migration-20260927/analysis/evidence-codes.md
!exp/style-reference-migration-20260927/analysis/ratings-template.csv
!exp/style-reference-migration-20260927/analysis/ratings-filled.csv
!exp/style-reference-migration-20260927/analysis/summary.json
# anime 探针的逐图评分同样入库
# 注意：git 不会进入被排除的**目录**里找反排除的文件，所以目录本身也要先 !，
# 再排除其内容，最后反排除具体文件（三层，缺一层就静默不生效）。
!exp/style-reference-migration-20260927/exec/
exp/style-reference-migration-20260927/exec/*
!exp/style-reference-migration-20260927/exec/anime/
exp/style-reference-migration-20260927/exec/anime/*
!exp/style-reference-migration-20260927/exec/anime/scores.csv
!exp/style-reference-migration-20260927/exec/anime/ratings-anime.json
!exp/style-reference-migration-20260927/exec/anime/summary.json

